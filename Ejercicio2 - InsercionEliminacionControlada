// Insertar en una posición específica (0 = inicio, contador = final)
    public void insertarPosicion(int dato, int posicion) {
        if (posicion <= 0) { insertarInicio(dato); return; }
        if (posicion >= contador) { insertarFinal(dato); return; }
 
        Nodo anterior = primero;
        for (int i = 0; i < posicion - 1; i++) {
            anterior = anterior.siguiente;
        }
        Nodo nuevo = new Nodo(dato);
        nuevo.siguiente = anterior.siguiente;
        anterior.siguiente = nuevo;
        contador++;
    }
 
    // Eliminar por posición (0 = primer elemento)
    public void eliminarPosicion(int posicion) {
        if (estaVacia()) {
            System.out.println("No se puede eliminar: la lista está vacía.");
            return;
        }
        if (posicion < 0 || posicion >= contador) {
            System.out.println("Posición inválida.");
            return;
        }
        if (contador == 1) {
            primero = null; ultimo = null; contador = 0;
            return;
        }
        if (posicion == 0) {
            primero = primero.siguiente;
            ultimo.siguiente = primero;
            contador--;
            return;
        }
        Nodo anterior = primero;
        for (int i = 0; i < posicion - 1; i++) {
            anterior = anterior.siguiente;
        }
        Nodo aEliminar = anterior.siguiente;
        anterior.siguiente = aEliminar.siguiente;
        if (aEliminar == ultimo) { ultimo = anterior; }
        contador--;
    }
 
    // Eliminar por valor (elimina la primera ocurrencia)
    public void eliminarValor(int valor) {
        if (estaVacia()) {
            System.out.println("No se puede eliminar: la lista está vacía.");
            return;
        }
        if (contador == 1) {
            if (primero.dato == valor) {
                primero = null; ultimo = null; contador = 0;
            } else {
                System.out.println("Valor no encontrado en la lista.");
            }
            return;
        }
        if (primero.dato == valor) {
            primero = primero.siguiente;
            ultimo.siguiente = primero;
            contador--;
            return;
        }
        Nodo anterior = primero;
        Nodo actual = primero.siguiente;
        while (actual != primero) {
            if (actual.dato == valor) {
                anterior.siguiente = actual.siguiente;
                if (actual == ultimo) { ultimo = anterior; }
                contador--;
                return;
            }
            anterior = actual;
            actual = actual.siguiente;
        }
        System.out.println("Valor no encontrado en la lista.");
    }
