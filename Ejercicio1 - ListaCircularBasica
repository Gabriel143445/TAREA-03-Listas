public class Nodo {
    int dato;
    Nodo siguiente;
 
    Nodo(int dato) {
        this.dato = dato;
        this.siguiente = null;
    }
}


public class ListaCircular {
 
    Nodo primero;
    Nodo ultimo;
    int contador = 0;
 
    public boolean estaVacia() {
        return primero == null;
    }
 
    public void insertarInicio(int dato) {
        Nodo nuevo = new Nodo(dato);
        if (estaVacia()) {
            primero = nuevo;
            ultimo = nuevo;
        } else {
            nuevo.siguiente = primero;
            primero = nuevo;
        }
        ultimo.siguiente = primero;
        contador++;
    }
 
    public void insertarFinal(int dato) {
        Nodo nuevo = new Nodo(dato);
        if (estaVacia()) {
            primero = nuevo;
            ultimo = nuevo;
        } else {
            ultimo.siguiente = nuevo;
            ultimo = nuevo;
        }
        ultimo.siguiente = primero;
        contador++;
    }
 
    public void mostrar() {
        if (estaVacia()) {
            System.out.println("La lista está vacía.");
            return;
        }
        Nodo actual = primero;
        System.out.print("Lista circular: ");
        do {
            System.out.print(actual.dato + " -> ");
            actual = actual.siguiente;
        } while (actual != primero);
        System.out.println("(vuelve al inicio)");
    }
 
    public int contarElementos() {
        return contador;
    }
}


import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        ListaCircular lista = new ListaCircular();
        Scanner scanner = new Scanner(System.in);
        int opcion;

        do {
            System.out.println("\n===== MENÚ - LISTA CIRCULAR =====");
            System.out.println("1. Insertar al inicio");
            System.out.println("2. Insertar al final");
            System.out.println("3. Mostrar todos los elementos");
            System.out.println("4. Verificar si la lista está vacía");
            System.out.println("5. Contar número de elementos");
            System.out.println("6. Salir");
            System.out.print("Elige una opción: ");
            opcion = Integer.parseInt(scanner.nextLine());

            switch (opcion) {
                case 1:
                    System.out.print("Ingresa el dato a insertar al inicio: ");
                    int datoInicio = Integer.parseInt(scanner.nextLine());
                    lista.insertarInicio(datoInicio);
                    System.out.println("Elemento insertado al inicio.");
                    break;

                case 2:
                    System.out.print("Ingresa el dato a insertar al final: ");
                    int datoFinal = Integer.parseInt(scanner.nextLine());
                    lista.insertarFinal(datoFinal);
                    System.out.println("Elemento insertado al final.");

                    break;

                case 3:
                    lista.mostrar();
                    break;

                case 4:
                    if (lista.estaVacia()) {
                        System.out.println("La lista está vacía.");
                    } else {
                        System.out.println("La lista NO está vacía.");
                    }
                    break;

                case 5:
                    System.out.println("Número de elementos: " + lista.contarElementos());
                    break;

                case 6:
                    System.out.println("Saliendo del programa...");
                    break;

                default:
                    System.out.println("Opción no válida, intenta de nuevo.");
            }

        } while (opcion != 6);

        scanner.close();
    }
}
